-- configuration
{
    "parameters": {
        "backPlateColor": { "default": [1.0, 0.0, 0.0], 
                            "role": "color",
                            "description": "Back plate image color (unlit)." },
        "opacity":        { "default": 1.0,
                            "description": "Back plate opacity (unlit)." },
        "gain":           { "default": [1.0, 1.0, 1.0], 
                            "role": "color",
                            "description": "Per-plate RGB gain." },
        "lift":           { "default": [1.0, 0.0, 0.0],
                            "role": "color",
                            "description": "Per-plate RGB lift." },
        "gamma":          { "default": [1.0, 1.0, 1.0], 
                            "role": "color",
                            "description": "Per-plate RGB gamma." }
    },
    "techniques": {
        "default": { "surfaceShader": { "source": [ "BackPlate.Surface" ] } }
    }
}
-- glsl BackPlate.Surface
vec4 surfaceShader(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
{
    vec3 lift =  HdGet_lift().rgb;
    vec3 gamma =  HdGet_gamma().rgb;
    vec3 gain =  HdGet_gain().rgb;
    vec3 finalColor = pow(HdGet_backPlateColor().rgb * gain  + lift, 1/gamma);
    return vec4(finalColor, HdGetScalar_opacity());
}

